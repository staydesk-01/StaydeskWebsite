# MongoDB connection string (required for form storage)
MONGODB_URI=mongodb://127.0.0.1:27017/staydesk

# Public app URL (used for metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: internal email notifications via Resend. If unset or failing, submissions still save.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
EMAIL_FROM="StayDesk <notifications@yourdomain.com>"
